# Copy to .env (gitignored). No secrets.

# SQLite path inside the backend container / local process
BURGER_DB=data/burger.db

# 1 = seed golden fixtures only when the target DB file is missing
# Never set this on the live ingest DB
BURGER_SEED_FIXTURES=0

# 1 = call live Tutu MCP (search only; never book/pay)
BURGER_LIVE_TUTU=0

# 1 = product may emit price_status=live (only after BOTH etalon and backup SC-price)
BURGER_SC_PRICE_ACCEPTED=0

# Coverage metadata JSON (same DB snapshot)
BURGER_COVERAGE=data/coverage.json
